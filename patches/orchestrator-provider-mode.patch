+func seedModeRelay(t *testing.T) *acpRelay {
+	r := newTestACPRelay(t)
+	request := relayClientFrame(t, r, []byte(`{"jsonrpc":"2.0","id":1,"method":"session/new","params":{}}`), 1)
+	relayProviderFrame(t, r, []byte(`{"jsonrpc":"2.0","id":`+frameID(t, request)+`,"result":{"sessionId":"owned","configOptions":[{"id":"mode","currentValue":"build"}]}}`), 1, true)
+	return r
