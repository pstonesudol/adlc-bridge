+	c.liveState.ModeKnown = true
+	c.liveState.CurrentMode = "plan"
+	if !c.ProviderModeSnapshotConfirmed() {
+		t.Fatal("owned host evidence was lost")
+	}
+	c.liveState.CurrentMode = "build"
+	if c.ProviderModeSnapshotConfirmed() {
+		t.Fatal("mismatching host evidence was accepted")
+	}
+}
