+// A mode update is provider evidence, not permission or implementation authority.
+// Unadvertised values invalidate earlier evidence; no aliases are guessed.
+func (c *conversation) confirmProviderMode(mode string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	for i := range c.configOptions {
+		option := &c.configOptions[i]
+		if option.ID == "mode" && option.Type == ports.ChatConfigOptionSelect {
+			option.Current = ports.ChatConfigOptionValue{Select: mode}
+			c.confirmedMode = ""
+			if choiceOffered(option.Choices, mode) {
+				c.confirmedMode = mode
+			}
+			c.modeConfirmation++
+			return
+		}
+	}
+}
+
+// Read-only bounded observation, never a setter retry. A timeout leaves the
+// selection unconfirmed, so startup cannot publish a usable controller.
+func (c *conversation) awaitModeConfirmation(ctx context.Context, mode string, since uint64) ([]ports.ChatConfigOption, error) {
+	deadline := time.NewTimer(250 * time.Millisecond)
+	defer deadline.Stop()
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.mu.Lock()
+		closed := c.closed
+		confirmed := c.modeConfirmation > since && c.confirmedMode == mode
+		options := cloneConfigOptions(c.configOptions)
+		c.mu.Unlock()
+		if closed {
+			return nil, errConversationClosed
+		}
+		if confirmed {
+			return options, nil
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-deadline.C:
+			return nil, fmt.Errorf("%w: provider did not confirm selected mode", ports.ErrChatRecoveryInconclusive)
+		case <-ticker.C:
+		}
 	}
 }
 
