+	r := seedModeRelay(t)
+	old := modeRequest(t, r, "2", "plan")
+	latest := modeRequest(t, r, "3", "build")
+	relayProviderFrame(t, r, []byte(`{"jsonrpc":"2.0","id":`+frameID(t, old)+`,"result":{"configOptions":[{"id":"mode","currentValue":"plan"}]}}`), 2, true)
+	if r.snapshot().ModeKnown {
+		t.Fatal("older request confirmed a newer uncertain selection")
+	}
+	relayProviderFrame(t, r, []byte(`{"jsonrpc":"2.0","id":`+frameID(t, latest)+`,"error":{"code":-32602,"message":"private provider error"}}`), 2, true)
