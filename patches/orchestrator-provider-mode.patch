+func TestModeReconnectRequiresPersistentHostProvenance(t *testing.T) {
+	c := &conversation{capabilities: make(ports.ChatCapabilities), liveState: &persistenthost.ACPState{}}
+	c.replaceConfigOptions([]acpsdk.SessionConfigOption{selectOption("mode", "Mode", "plan", "build", "plan")})
