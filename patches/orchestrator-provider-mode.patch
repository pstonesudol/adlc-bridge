+func TestProviderModeFailureAPIContractIsSanitized(t *testing.T) {
+	for _, kind := range []string{"unsupported", "rejected", "unconfirmed", "transient", "uncertain"} {
+		cause := &chatsvc.ProviderModeRestoreError{Kind: kind, Requested: "plan", Observed: "build"}
+		mapped := toAPIError(fmt.Errorf("private provider token must not appear: %w", cause))
+		var api *apierr.Error
+		if !errors.As(mapped, &api) || api.Code != "PROVIDER_MODE_RESTORE_FAILED" {
+			t.Fatalf("mapped=%v", mapped)
+		}
+		if api.Details["failureKind"] != kind || api.Details["requestedMode"] != "plan" || api.Details["observedMode"] != "build" || api.Details["retrySafe"] != false {
+			t.Fatalf("details=%+v", api.Details)
+		}
+		if strings.Contains(api.Message, "private") {
