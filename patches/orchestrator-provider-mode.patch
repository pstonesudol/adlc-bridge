+package controllers
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/httpd/envelope"
+	chatsvc "github.com/aoagents/agent-orchestrator/backend/internal/service/chat"
+)
+
+func TestProviderModeSetterUnconfirmedHTTPEnvelope(t *testing.T) {
+	w := httptest.NewRecorder()
+	failure := &chatsvc.ProviderModeRestoreError{Kind: "unconfirmed", Requested: "plan", Observed: "plan"}
+	writeConversationError(w, httptest.NewRequest("PATCH", "/conversation/config-options/mode", nil), fmt.Errorf("private provider output: %w", failure))
+	if w.Code != http.StatusConflict {
+		t.Fatalf("status=%d body=%s", w.Code, w.Body.String())
+	}
+	var body envelope.APIError
+	if err := json.Unmarshal(w.Body.Bytes(), &body); err != nil {
+		t.Fatal(err)
+	}
+	if body.Code != "PROVIDER_MODE_RESTORE_FAILED" || body.Details["failureKind"] != "unconfirmed" || body.Details["retrySafe"] != false || body.Details["requestedMode"] != "plan" {
+		t.Fatalf("lost mode classification: %+v", body)
+	}
+	if strings.Contains(w.Body.String(), "private provider") {
+		t.Fatal("raw provider error leaked")
+	}
+}
