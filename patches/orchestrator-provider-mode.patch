+func TestModeConfirmationNeverBorrowsCachedOrStaleEvidence(t *testing.T) {
+	c := &conversation{capabilities: make(ports.ChatCapabilities)}
+	c.replaceConfigOptions([]acpsdk.SessionConfigOption{selectOption("mode", "Mode", "build", "build", "plan")})
+	c.applyAcceptedConfigOption("mode", ports.ChatConfigOptionValue{Select: "plan"})
+	ctx, cancel := context.WithTimeout(context.Background(), time.Millisecond)
+	defer cancel()
+	if options, err := c.awaitModeConfirmation(ctx, "plan", c.modeConfirmation); err == nil || len(options) != 0 {
+		t.Fatal("optimistic cache counted as confirmation")
+	}
+	c.confirmProviderMode("plan")
+	generation := c.modeConfirmation
+	c.confirmProviderMode("unknown")
+	if c.confirmedMode != "" || c.modeConfirmation <= generation {
+		t.Fatal("unadvertised mode retained stale confirmation")
+	}
+	// Cancellation observes only; it cannot replay a selection or send a turn.
+	ctx2, cancel2 := context.WithCancel(context.Background())
+	cancel2()
+	if options, err := c.awaitModeConfirmation(ctx2, "plan", generation); err == nil || len(options) != 0 {
+		t.Fatal("cancelled/unconfirmed observation accepted")
+	}
+}
