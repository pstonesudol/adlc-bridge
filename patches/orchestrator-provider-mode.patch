+	r := seedModeRelay(t)
+	relayProviderFrame(t, r, []byte(`{"method":"session/update","params":{"sessionId":"owned","update":{"sessionUpdate":"config_option_update","configOptions":[]}}}`), 1, true)
+	if r.snapshot().ModeKnown {
+		t.Fatal("removed mode remained confirmed")
+	}
+}
