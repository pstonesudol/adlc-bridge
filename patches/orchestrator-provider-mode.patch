+func TestModeCatalogSnapshotPreservesMixedTypesAndAmbiguity(t *testing.T) {
+	r := seedModeRelay(t)
+	r.captureModeCatalog([]byte(`{"configOptions":[{"id":"fast","currentValue":false},{"id":"mode","currentValue":"plan"}]}`), false)
