 // writeConversationError maps the Chat service's typed failures onto stable
 // codes, so a client can tell a permanent answer from a retryable one.
 func writeConversationError(w http.ResponseWriter, r *http.Request, err error) {
+	var modeFailure *chatsvc.ProviderModeRestoreError
+	if errors.As(err, &modeFailure) {
+		kind, requested, observed := modeFailure.ProviderModeRestoreDetails()
+		envelope.WriteAPIError(w, r, http.StatusConflict, "conflict", "PROVIDER_MODE_RESTORE_FAILED",
+			"Provider mode "+kind+": requested="+requested+" observed="+observed+". Preserve the session and permissions; inspect native compatibility before explicit recovery. No automatic retry.",
+			map[string]any{"failureKind": kind, "requestedMode": requested, "observedMode": observed, "retrySafe": false})
+		return
+	}
 	switch {
 	case errors.Is(err, chatsvc.ErrFileReferenceInvalid):
 		envelope.WriteAPIError(w, r, http.StatusBadRequest, "validation", "CHAT_FILE_REFERENCE_INVALID", err.Error(), nil)
