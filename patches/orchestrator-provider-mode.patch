+// Reproduces the native restore boundary: an ACP peer advertises a modern
+// mode picker but confirms selection through current_mode_update rather than
+// the optional-in-practice response catalog. No provider or model is launched.
+func TestModeConfirmationRequiresProviderEvidence(t *testing.T) {
+	for _, ids := range [][2]string{{"build", "plan"}, {"edit", "inspect"}} {
+		for _, update := range []string{"", ids[0], "unadvertised", ids[1]} {
+			t.Run(ids[1]+"/"+update, func(t *testing.T) {
+				agent := &fakeAgent{newConfig: []acpsdk.SessionConfigOption{selectOption("mode", "Mode", ids[0], ids[0], ids[1])}, modeUpdateOnSet: update}
+				driver := New(Config{Harness: domain.HarnessFake, Capabilities: ports.ChatCapabilities{ports.ChatCapabilityStreaming: true}, Probe: func(context.Context) error { return nil }, Launch: func(context.Context, LaunchConfig) (Launch, error) { return Launch{Command: "fake"}, nil }}, slog.New(slog.NewTextHandler(io.Discard, nil)))
+				driver.useTestProcess(fakeSpawn(agent))
+				conv, err := driver.Start(context.Background(), ports.ChatStartConfig{SessionID: "mode-test", WorkspacePath: t.TempDir(), Permissions: ports.PermissionModeDefault})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conv.Close()
+				c := conv.(*conversation)
+				before := c.permissionMode
+				options, err := c.SetConfigOption(context.Background(), "mode", ports.ChatConfigOptionValue{Select: ids[1]})
+				if update == ids[1] {
+					if err != nil {
+						t.Fatal(err)
+					}
+				} else if !errors.Is(err, ports.ErrChatRecoveryInconclusive) {
+					t.Fatalf("want unconfirmed mode error, got %v", err)
+				}
+				confirmed := false
+				for _, option := range options {
+					if option.ID == "mode" && option.Current.Select == ids[1] {
+						confirmed = true
+					}
+				}
+				if confirmed != (update == ids[1]) {
+					t.Fatalf("confirmation=%v, update=%q options=%+v", confirmed, update, options)
+				}
+				c.mu.Lock()
+				after := c.permissionMode
+				c.mu.Unlock()
+				if before != after {
+					t.Fatal("mode selection changed permission policy")
+				}
+				agent.mu.Lock()
+				calls := agent.setCalls
+				agent.mu.Unlock()
+				if calls != 1 {
+					t.Fatalf("mode setter called %d times; never retry uncertain selection", calls)
+				}
+			})
+		}
+	}
+}
