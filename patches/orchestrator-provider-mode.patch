+func modeRequest(t *testing.T, r *acpRelay, id, value string) []byte {
+	return relayClientFrame(t, r, []byte(`{"jsonrpc":"2.0","id":`+id+`,"method":"session/set_config_option","params":{"sessionId":"owned","configId":"mode","value":"`+value+`"}}`), 1)
+}
+func TestModeUncertaintySurvivesDaemonAttachmentWithoutReplay(t *testing.T) {
+	r := seedModeRelay(t)
+	if !r.snapshot().ModeKnown {
+		t.Fatal("setup mode not observed")
+	}
+	request := modeRequest(t, r, "2", "plan")
+	// Snapshot serialization is the host/daemon attachment boundary. The host
+	// remains the same owner while a replacement daemon must retain uncertainty.
+	raw, err := json.Marshal(r.snapshot())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var restarted ACPState
+	if err = json.Unmarshal(raw, &restarted); err != nil {
+		t.Fatal(err)
+	}
+	if restarted.ModeKnown || restarted.CurrentMode != "" {
+		t.Fatal("uncertain mode became confirmed on attachment")
+	}
+	if len(relayReplayFrames(t, r)) != 0 {
+		t.Fatal("mode request was replayed")
+	}
+	// A late empty reply from the old attachment is not evidence or a new send.
+	relayProviderFrame(t, r, []byte(`{"jsonrpc":"2.0","id":`+frameID(t, request)+`,"result":{}}`), 2, false)
+	if r.snapshot().ModeKnown || r.snapshot().ActivePrompt {
+		t.Fatal("empty acknowledgement confirmed mode or created a turn")
+	}
+	relayProviderFrame(t, r, []byte(`{"method":"session/update","params":{"sessionId":"other","update":{"sessionUpdate":"current_mode_update","currentModeId":"plan"}}}`), 2, false)
+	if r.snapshot().ModeKnown {
+		t.Fatal("foreign session supplied confirmation")
+	}
+	relayProviderFrame(t, r, []byte(`{"method":"session/update","params":{"sessionId":"owned","update":{"sessionUpdate":"current_mode_update","currentModeId":"plan"}}}`), 2, false)
+	if !r.snapshot().ModeKnown || r.snapshot().CurrentMode != "plan" {
+		t.Fatal("fresh owned provider evidence lost")
+	}
+	if len(relayReplayFrames(t, r)) != 0 {
+		t.Fatal("mode recovery duplicated a turn")
+	}
+}
