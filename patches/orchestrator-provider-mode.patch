+package chat
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/domain"
+	"github.com/aoagents/agent-orchestrator/backend/internal/ports"
+)
+
+// ProviderModeRestoreError is intentionally free of provider error bodies.
+// The original cause remains available to errors.Is/As, not operator output.
+type ProviderModeRestoreError struct {
+	Kind, Requested, Observed string
+	cause                     error
+}
+
+func (e *ProviderModeRestoreError) Error() string {
+	return fmt.Sprintf("provider mode restore %s: requested=%q observed=%q; preserve the original session and permission boundary; inspect advertised modes and native compatibility, then explicitly recover; no automatic retry", e.Kind, safeModeID(e.Requested), safeModeID(e.Observed))
+}
+func (e *ProviderModeRestoreError) Unwrap() error { return e.cause }
+func (e *ProviderModeRestoreError) ProviderModeRestoreDetails() (kind, requested, observed string) {
+	kind = e.Kind
+	switch kind {
+	case "unsupported", "rejected", "unconfirmed", "transient", "uncertain":
+	default:
+		kind = "uncertain"
+	}
+	return kind, safeModeID(e.Requested), safeModeID(e.Observed)
+}
+func safeModeID(id string) string {
+	if len(id) == 0 || len(id) > 80 {
+		return "unknown"
+	}
+	for _, c := range id {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.') {
+			return "unknown"
+		}
+	}
+	return id
+}
+
+// Restore one exact saved provider identifier. Semantic intent and authority
+// remain with ADLC/the caller; there is no mode-name inference or fallback.
+// Called under the existing startup ownership gate, before controller publication.
+func restoreProviderMode(ctx context.Context, conv ports.ChatConversation, mode string, permission domain.PermissionMode, verifyOnly bool) error {
+	observed := ""
+	fail := func(kind string, cause error) error {
+		return &ProviderModeRestoreError{Kind: kind, Requested: mode, Observed: observed, cause: cause}
+	}
+	configurer, ok := conv.(ports.ChatConfigOptionController)
+	if !ok {
+		return fail("unsupported", ErrConfigOptionsUnsupported)
+	}
+	if err := ctx.Err(); err != nil {
+		return fail("transient", err)
+	}
+	options, err := configurer.ListConfigOptions(ctx)
+	if err != nil {
+		if errors.Is(err, ErrConfigOptionsUnsupported) {
+			return fail("unsupported", err)
+		}
+		return fail("transient", err)
+	} // No selection was attempted.
+	offered := false
+	count := 0
+	for _, option := range options {
+		if option.ID != "mode" {
+			continue
+		}
+		count++
+		observed = option.Current.Select
+		for _, choice := range option.Choices {
+			if choice.Value != mode {
+				continue
+			}
+			if choice.PermissionMode != "" && ports.NormalizePermissionMode(choice.PermissionMode) != ports.NormalizePermissionMode(permission) {
+				return fail("rejected", ports.ErrChatConfigOptionInvalid)
+			}
+			if offered {
+				return fail("unsupported", ports.ErrChatConfigOptionInvalid)
+			}
+			offered = true
+		}
+	}
+	if count != 1 || !offered {
+		return fail("unsupported", ports.ErrChatConfigOptionInvalid)
+	}
+	// A reconnected host may own an in-flight turn. Inspect its published state
+	// only; never use reconnect as authority to mutate a mode or bypass a failed
+	// restore. The saved requested mode is retained by existing durable settings.
+	if verifyOnly {
+		provenance, ok := conv.(interface{ ProviderModeSnapshotConfirmed() bool })
+		if observed != mode || !ok || !provenance.ProviderModeSnapshotConfirmed() {
+			return fail("unconfirmed", ports.ErrChatRecoveryInconclusive)
+		}
+		return nil
+	}
+	// Exactly one mutation. A transport failure may have applied the mode; neither
+	// this helper nor startup retries it or sends a turn to test the outcome.
+	options, err = configurer.SetConfigOption(ctx, "mode", ports.ChatConfigOptionValue{Select: mode})
+	if err != nil {
+		if errors.Is(err, ports.ErrChatRecoveryInconclusive) {
+			return fail("unconfirmed", err)
+		}
+		if errors.Is(err, ports.ErrChatUnsupported) {
+			return fail("unsupported", err)
+		}
+		if errors.Is(err, ports.ErrChatConfigOptionInvalid) {
+			return fail("rejected", err)
+		}
+		return fail("uncertain", err)
+	}
+	count = 0
+	confirmed := false
+	matches := 0
+	for _, option := range options {
+		if option.ID != "mode" {
+			continue
+		}
+		count++
+		observed = option.Current.Select
+		for _, choice := range option.Choices {
+			if choice.Value == mode {
+				matches++
+			}
+			if choice.Value == mode && choice.PermissionMode != "" && ports.NormalizePermissionMode(choice.PermissionMode) != ports.NormalizePermissionMode(permission) {
+				return fail("rejected", ports.ErrChatConfigOptionInvalid)
+			}
+			if choice.Value == mode && option.Current.Select == mode {
+				confirmed = true
+			}
+		}
+	}
+	if count != 1 || !confirmed || matches != 1 {
+		return fail("unconfirmed", ports.ErrChatRecoveryInconclusive)
+	}
+	return nil
+}
