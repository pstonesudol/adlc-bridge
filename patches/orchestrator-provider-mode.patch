+func TestModeSetterTimeoutCannotUseCachedCatalog(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		t.Run(map[bool]string{false: "modern-unconfirmed", true: "legacy-confirmed"}[legacy], func(t *testing.T) {
+			agent := &fakeAgent{newConfig: []acpsdk.SessionConfigOption{selectOption("mode", "Mode", "plan", "build", "plan")}}
+			driver := New(Config{Harness: domain.HarnessFake, Capabilities: ports.ChatCapabilities{ports.ChatCapabilityStreaming: true}, Probe: func(context.Context) error { return nil }, Launch: func(context.Context, LaunchConfig) (Launch, error) { return Launch{Command: "fake"}, nil }}, slog.New(slog.NewTextHandler(io.Discard, nil)))
+			driver.useTestProcess(fakeSpawn(agent))
+			conv, err := driver.Start(context.Background(), ports.ChatStartConfig{SessionID: "cached-mode", WorkspacePath: t.TempDir(), Permissions: ports.PermissionModeDefault})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conv.Close()
+			c := conv.(*conversation)
+			c.legacyMode = legacy
+			options, err := c.SetConfigOption(context.Background(), "mode", ports.ChatConfigOptionValue{Select: "plan"})
+			if legacy {
+				if err != nil || len(options) != 1 || options[0].Current.Select != "plan" {
+					t.Fatalf("legacy selection lost confirmation: %+v %v", options, err)
+				}
+			} else {
+				if !errors.Is(err, ports.ErrChatRecoveryInconclusive) || len(options) != 0 {
+					t.Fatalf("unconfirmed setter can fall back to cached Plan: %+v %v", options, err)
+				}
+				cached, readErr := c.ListConfigOptions(context.Background())
+				if readErr != nil || len(cached) != 1 || cached[0].Current.Select != "plan" {
+					t.Fatal("fixture must retain the pre-existing cached Plan")
+				}
+			}
+			if c.permissionMode != ports.PermissionModeDefault {
+				t.Fatal("selection changed permissions")
+			}
+		})
+	}
+}
