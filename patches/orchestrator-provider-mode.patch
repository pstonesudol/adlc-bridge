+// Capture protocol-owned evidence only; workflow intent and permission semantics
+// remain in adapters. The adapter validates identifiers against advertised modes.
+func (r *acpRelay) captureModeCatalog(raw json.RawMessage, setup bool) {
+	var value struct {
+		Options []struct {
+			ID      string          `json:"id"`
+			Current json.RawMessage `json:"currentValue"`
+		} `json:"configOptions"`
+		Modes *struct {
+			Current string `json:"currentModeId"`
+		} `json:"modes"`
+	}
+	if json.Unmarshal(raw, &value) != nil {
+		return
+	}
+	if !setup && len(value.Options) == 0 {
+		return
+	}
+	// Retain the latest provider-owned catalog, not the original setup picker.
+	// A reconnect must still reject removed, duplicate or unadvertised modes.
+	var incoming, snapshot map[string]json.RawMessage
+	if json.Unmarshal(raw, &incoming) == nil && incoming["configOptions"] != nil && json.Unmarshal(r.state.SessionResult, &snapshot) == nil && snapshot != nil {
+		snapshot["configOptions"] = append(json.RawMessage(nil), incoming["configOptions"]...)
+		r.state.SessionResult, _ = json.Marshal(snapshot)
+	}
+	r.state.ModeKnown = false
+	r.state.CurrentMode = ""
+	count := 0
+	current := ""
+	for _, option := range value.Options {
+		if option.ID == "mode" {
+			count++
+			_ = json.Unmarshal(option.Current, &current)
+		}
+	}
+	if count > 0 {
+		r.state.ModeKnown = count == 1 && current != ""
+		r.state.CurrentMode = current
+		return
+	}
+	if setup && value.Modes != nil && value.Modes.Current != "" {
+		r.state.ModeKnown = true
+		r.state.CurrentMode = value.Modes.Current
+	}
+}
+
+func (r *acpRelay) captureModeUpdate(raw json.RawMessage) {
+	var params struct {
+		Session string `json:"sessionId"`
+		Update  struct {
+			Kind    string          `json:"sessionUpdate"`
+			Current string          `json:"currentModeId"`
+			Options json.RawMessage `json:"configOptions"`
+		} `json:"update"`
+	}
+	if json.Unmarshal(raw, &params) != nil || params.Session != r.state.SessionID {
+		return
+	}
+	switch params.Update.Kind {
+	case "current_mode_update":
+		r.state.ModeKnown = params.Update.Current != ""
+		r.state.CurrentMode = params.Update.Current
+	case "config_option_update":
+		// Empty notification means removal, unlike an empty setter ack.
+		r.state.ModeKnown = false
+		r.state.CurrentMode = ""
+		catalog, _ := json.Marshal(map[string]json.RawMessage{"configOptions": params.Update.Options})
+		r.captureModeCatalog(catalog, true)
 	}
 }
 
