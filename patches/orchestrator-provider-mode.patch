+
+func TestProviderModeRestoreContract(t *testing.T) {
+	for _, ids := range [][2]string{{"plan", "build"}, {"inspect", "edit"}} {
+		for _, kind := range []string{"confirmed", "unsupported", "unsupported-setter", "rejected", "unconfirmed", "unconfirmed-setter", "transient", "uncertain", "permission", "duplicate"} {
+			t.Run(ids[0]+"/"+kind, func(t *testing.T) {
+				f := &restoreModeFixture{catalog: restoreCatalog(ids[1], ids[0], ids[1]), response: restoreCatalog(ids[0], ids[0], ids[1])}
+				expectedCalls := 1
+				expectedKind := kind
+				switch kind {
+				case "unconfirmed-setter":
+					f.setErr = ports.ErrChatRecoveryInconclusive
+					expectedKind = "unconfirmed"
+				case "unsupported-setter":
+					f.setErr = ports.ErrChatUnsupported
+					expectedKind = "unsupported"
+				case "duplicate":
+					f.response[0].Choices = append(f.response[0].Choices, f.response[0].Choices[0])
+					expectedKind = "unconfirmed"
+				case "unsupported":
+					f.catalog = nil
+					expectedCalls = 0
+				case "rejected":
+					f.setErr = ports.ErrChatConfigOptionInvalid
+				case "unconfirmed":
+					f.response = nil
+				case "transient":
+					f.readErr = context.DeadlineExceeded
+					expectedCalls = 0
+				case "uncertain":
+					f.setErr = errors.New("Bearer credentials must not be printed")
+				case "permission":
+					f.catalog[0].Choices[0].PermissionMode = ports.PermissionModeBypassPermissions
+					expectedCalls = 0
+					expectedKind = "rejected"
+				}
+				err := restoreProviderMode(context.Background(), f, ids[0], ports.PermissionModeDefault, false)
+				if kind == "confirmed" {
+					if err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					var failure *ProviderModeRestoreError
+					if !errors.As(err, &failure) || failure.Kind != expectedKind {
+						t.Fatalf("error=%v, want %s", err, expectedKind)
+					}
+					if strings.Contains(err.Error(), "credentials") {
+						t.Fatal("provider error body leaked")
+					}
+				}
+				if f.calls != expectedCalls {
+					t.Fatalf("setter calls=%d want %d", f.calls, expectedCalls)
+				}
+			})
+		}
+	}
+}
+
+func TestProviderModeRestoreRestartNeverBypassesUnconfirmedOrMutatesLiveHost(t *testing.T) {
+	// Persisted settings still request Plan after failure. A reconnect observes
+	// Build and must fail each time without selecting a mode or injecting a turn.
+	f := &restoreModeFixture{catalog: restoreCatalog("build", "plan", "build")}
+	for i := 0; i < 3; i++ {
+		if err := restoreProviderMode(context.Background(), f, "plan", ports.PermissionModeDefault, true); err == nil {
+			t.Fatal("unconfirmed live mode admitted")
+		}
+	}
+	if f.calls != 0 {
+		t.Fatal("reconnect changed an in-flight host")
+	}
+	f.catalog = restoreCatalog("plan", "plan", "build")
+	if err := restoreProviderMode(context.Background(), f, "plan", ports.PermissionModeDefault, true); err == nil {
+		t.Fatal("old setup snapshot counted as mode evidence")
+	}
+	f.known = true
+	if err := restoreProviderMode(context.Background(), f, "plan", ports.PermissionModeDefault, true); err != nil {
+		t.Fatal(err)
+	}
+	if f.calls != 0 {
+		t.Fatal("already confirmed mode was mutated")
+	}
+}
