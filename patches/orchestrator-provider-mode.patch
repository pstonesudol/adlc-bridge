 // toAPIError maps the session engine's sentinel errors to their REST API
 // equivalents; an unrecognized error passes through and surfaces as a 500.
 func toAPIError(err error) error {
+	// Mode restoration carries a narrow sanitized diagnostic contract. Check it
+	// before generic timeout/relaunch mappings, which would lose its evidence.
+	var modeFailure interface {
+		ProviderModeRestoreDetails() (kind, requested, observed string)
+	}
+	if errors.As(err, &modeFailure) {
+		kind, requested, observed := modeFailure.ProviderModeRestoreDetails()
+		return apierr.Conflict("PROVIDER_MODE_RESTORE_FAILED",
+			fmt.Sprintf("Provider mode restore %s: requested=%q observed=%q. Preserve the original session and permissions; inspect native/provider compatibility before explicit recovery. No automatic retry.", kind, requested, observed),
+			map[string]any{"failureKind": kind, "requestedMode": requested, "observedMode": observed, "retrySafe": false})
+	}
 	original := ownership.Own(err, ownership.OwnerHTTP)
 	return ownership.Preserve(original, mapSessionError(original))
 }
