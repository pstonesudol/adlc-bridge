+func TestSelectiveRerunKeepsOtherSameNameJobFailure(t *testing.T) {
+	f := newFakeGH(t)
+	for id := 1; id <= 3; id++ {
+		id := id
+		f.on(http.MethodGet, fmt.Sprintf("/repos/owner/repo/actions/jobs/%d", id), func(w http.ResponseWriter, _ *http.Request) {
+			attempt := 1; if id == 3 { attempt = 2 }
+			_ = json.NewEncoder(w).Encode(map[string]any{"id": id, "run_id": 10, "head_sha": "head", "run_attempt": attempt, "check_run_url": fmt.Sprintf("https://api.github.com/repos/owner/repo/check-runs/%d", id)})
+		})
+	}
+	f.on(http.MethodGet, "/repos/owner/repo/actions/runs/10", func(w http.ResponseWriter, _ *http.Request) {
+		_ = json.NewEncoder(w).Encode(map[string]any{"id": 10, "head_sha": "head", "workflow_id": 5, "run_number": 7, "event": "pull_request", "repository": map[string]any{"full_name": "owner/repo"}})
+	})
+	a, b, c := rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS"), rerunCheck(3, "COMPLETED", "SUCCESS")
+	for i, check := range []map[string]any{a, b, c} { check["detailsUrl"] = fmt.Sprintf("https://github.com/owner/repo/actions/runs/10/job/%d", i+1) }
+	pr := rerunPR(a, b, c)
+	if err := newProviderForTest(t, f).normalizeCheckReruns(ctx(), "owner", "repo", "head", pr); err != nil { t.Fatal(err) }
+	if len(nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])) != 3 || ciSummaryFromGraphQL(pr) != domain.CIFailing || ciSummaryFromRollupState(pr) != domain.CIFailing { t.Fatal("selective rerun suppressed another job's failure") }
+}
