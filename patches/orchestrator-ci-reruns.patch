+package github
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"github.com/aoagents/agent-orchestrator/backend/internal/domain"
+	"testing"
+)
+
+func rerunPR(checks ...map[string]any) map[string]any {
+	raw := []any{}
+	for _, c := range checks {
+		raw = append(raw, c)
+	}
+	return map[string]any{"commits": map[string]any{"nodes": []any{map[string]any{"commit": map[string]any{"statusCheckRollup": map[string]any{"state": "FAILURE", "contexts": map[string]any{"nodes": raw, "pageInfo": map[string]any{"hasNextPage": false}}}}}}}}
+}
+func rerunCheck(id int, status, conclusion string) map[string]any {
+	return map[string]any{"__typename": "CheckRun", "name": "PR body structure", "databaseId": float64(id), "status": status, "conclusion": conclusion}
+}
+func TestSupersededActionsFailureDoesNotKeepBoardRed(t *testing.T) {
+	pr := rerunPR(rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS"))
+	err := supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) {
+		return checkRunAttempt{"workflow:pull_request", "logical-job", int64(num(n["databaseId"])), 1}, true, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := ciSummaryFromGraphQL(pr); got != domain.CIPassing {
+		t.Fatalf("legacy CI=%s", got)
+	}
+	if got := ciSummaryFromRollupState(pr); got != domain.CIPassing {
+		t.Fatalf("observer CI=%s", got)
+	}
+	if len(nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])) != 1 {
+		t.Fatal("older run retained")
+	}
+}
+func TestSeparateWorkflowsDoNotHideFailure(t *testing.T) {
+	pr := rerunPR(rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS"))
+	_ = supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) {
+		return checkRunAttempt{fmt.Sprint(n["databaseId"]), "logical-job", 1, 1}, true, nil
+	})
+	if ciSummaryFromGraphQL(pr) != domain.CIFailing {
+		t.Fatal("distinct failure hidden")
+	}
+}
+func TestPendingRerunDoesNotInheritOldFailureOrPass(t *testing.T) {
+	pr := rerunPR(rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "IN_PROGRESS", ""))
+	_ = supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) {
+		return checkRunAttempt{"workflow", "logical-job", int64(num(n["databaseId"])), 1}, true, nil
+	})
+	if ciSummaryFromRollupState(pr) != domain.CIPending {
+		t.Fatal("pending rerun not pending")
+	}
+}
+func TestUnverifiedAndPartialChecksKeepFailure(t *testing.T) {
+	for _, partial := range []bool{false, true} {
+		pr := rerunPR(rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS"))
+		statusRollup(pr)["contexts"].(map[string]any)["pageInfo"] = map[string]any{"hasNextPage": partial}
+		_ = supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) { return checkRunAttempt{}, false, nil })
+		if ciSummaryFromGraphQL(pr) != domain.CIFailing {
+			t.Fatal("unverified failure hidden")
+		}
+	}
+}
+
+// Exercise the real REST provenance resolver, not only the grouping helper.
+func TestNormalizeCheckRerunsProvenanceAndAttempts(t *testing.T) {
+	for _, conclusion := range []string{"SUCCESS", "FAILURE"} {
+		for _, reverse := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/reverse=%v", conclusion, reverse), func(t *testing.T) {
+				f := newFakeGH(t)
+				for id := 1; id <= 2; id++ {
+					id := id
+					f.on(http.MethodGet, fmt.Sprintf("/repos/owner/repo/actions/jobs/%d", id), func(w http.ResponseWriter, _ *http.Request) {
+						_ = json.NewEncoder(w).Encode(map[string]any{"id": id, "run_id": 10, "head_sha": "head", "run_attempt": id, "check_run_url": fmt.Sprintf("https://api.github.com/repos/owner/repo/check-runs/%d", id)})
+					})
+				}
+				f.on(http.MethodGet, "/repos/owner/repo/actions/runs/10", func(w http.ResponseWriter, _ *http.Request) {
+					_ = json.NewEncoder(w).Encode(map[string]any{"id": 10, "head_sha": "head", "workflow_id": 5, "run_number": 7, "event": "pull_request", "repository": map[string]any{"full_name": "owner/repo"}})
+				})
+				old := "FAILURE"
+				if conclusion == "FAILURE" { old = "SUCCESS" }
+				a, b := rerunCheck(1, "COMPLETED", old), rerunCheck(2, "COMPLETED", conclusion)
+				a["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/1"
+				b["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/2"
+				if reverse { a, b = b, a }
+				pr := rerunPR(a, b)
+				if err := newProviderForTest(t, f).normalizeCheckReruns(ctx(), "owner", "repo", "head", pr); err != nil { t.Fatal(err) }
+				kept := nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])
+				if len(kept) != 2 { t.Fatalf("distinct job IDs were superseded: %#v", kept) }
+				if ciSummaryFromGraphQL(pr) != domain.CIFailing || ciSummaryFromRollupState(pr) != domain.CIFailing { t.Fatal("unproven logical job identity hid a failure") }
+				if got := f.callsTo(http.MethodGet, "/repos/owner/repo/actions/runs/10"); got != 1 { t.Fatalf("run lookup calls=%d, want 1", got) }
+			})
+		}
+	}
+	for _, field := range []string{"job.head_sha", "job.check_run_url", "job.run_id", "run.head_sha", "run.repository", "url.host", "url.path"} {
+		t.Run(field, func(t *testing.T) {
+			f := newFakeGH(t)
+			for id := 1; id <= 2; id++ {
+				id := id
+				f.on(http.MethodGet, fmt.Sprintf("/repos/owner/repo/actions/jobs/%d", id), func(w http.ResponseWriter, _ *http.Request) {
+					job := map[string]any{"id": id, "run_id": 10, "head_sha": "head", "run_attempt": id, "check_run_url": fmt.Sprintf("https://api.github.com/repos/owner/repo/check-runs/%d", id)}
+					if id == 2 {
+						switch field {
+						case "job.head_sha": job["head_sha"] = "forged"
+						case "job.check_run_url": job["check_run_url"] = "https://api.github.com/repos/foreign/repo/check-runs/2"
+						case "job.run_id": job["run_id"] = 99
+						}
+					}
+					_ = json.NewEncoder(w).Encode(job)
+				})
+			}
+			f.on(http.MethodGet, "/repos/owner/repo/actions/runs/10", func(w http.ResponseWriter, _ *http.Request) {
+				run := map[string]any{"id": 10, "head_sha": "head", "workflow_id": 5, "run_number": 7, "event": "pull_request", "repository": map[string]any{"full_name": "owner/repo"}}
+				if field == "run.head_sha" { run["head_sha"] = "forged" }
+				if field == "run.repository" { run["repository"] = map[string]any{"full_name": "foreign/repo"} }
+				_ = json.NewEncoder(w).Encode(run)
+			})
+			a, b := rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS")
+			a["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/1"
+			b["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/2"
+			if field == "url.host" { b["detailsUrl"] = "https://evil.test/owner/repo/actions/runs/10/job/2" }
+			if field == "url.path" { b["detailsUrl"] = "https://github.com/foreign/repo/actions/runs/10/job/2" }
+			pr := rerunPR(a, b)
+			err := newProviderForTest(t, f).normalizeCheckReruns(ctx(), "owner", "repo", "head", pr)
+			if err != nil { t.Fatalf("unverified provenance should retain the original observation: %v", err) }
+			if ciSummaryFromGraphQL(pr) != domain.CIFailing || len(nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])) != 2 { t.Fatal("unverified failure suppressed") }
+		})
+	}
+}
+func TestRerunReadErrorsKeepOriginalFailure(t *testing.T) {
+	for _, failure := range []string{"job-error", "job-json", "run-error", "run-json"} {
+		t.Run(failure, func(t *testing.T) {
+			f := newFakeGH(t)
+			for id := 1; id <= 2; id++ {
+				id := id
+				f.on(http.MethodGet, fmt.Sprintf("/repos/owner/repo/actions/jobs/%d", id), func(w http.ResponseWriter, _ *http.Request) {
+					if failure == "job-error" { http.Error(w, "unavailable", http.StatusNotFound); return }
+					if failure == "job-json" { _, _ = w.Write([]byte("not JSON")); return }
+					_ = json.NewEncoder(w).Encode(map[string]any{"id": id, "run_id": 10, "head_sha": "head", "run_attempt": id, "check_run_url": fmt.Sprintf("https://api.github.com/repos/owner/repo/check-runs/%d", id)})
+				})
+			}
+			f.on(http.MethodGet, "/repos/owner/repo/actions/runs/10", func(w http.ResponseWriter, _ *http.Request) {
+				if failure == "run-error" { http.Error(w, "unavailable", http.StatusNotFound); return }
+				_, _ = w.Write([]byte("not JSON"))
+			})
+			a, b := rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS")
+			a["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/1"
+			b["detailsUrl"] = "https://github.com/owner/repo/actions/runs/10/job/2"
+			pr := rerunPR(a, b)
+			if err := newProviderForTest(t, f).normalizeCheckReruns(ctx(), "owner", "repo", "head", pr); err != nil { t.Fatal(err) }
+			if ciSummaryFromGraphQL(pr) != domain.CIFailing || ciSummaryFromRollupState(pr) != domain.CIFailing || len(nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])) != 2 { t.Fatal("read failure suppressed original checks") }
+		})
+	}
+}
