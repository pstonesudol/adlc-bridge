+func TestDistinctOrUnknownLogicalJobsNeverSupersede(t *testing.T) {
+	for _, missing := range []bool{false, true} {
+		pr := rerunPR(rerunCheck(1, "COMPLETED", "FAILURE"), rerunCheck(2, "COMPLETED", "SUCCESS"), rerunCheck(3, "COMPLETED", "SUCCESS"))
+		_ = supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) {
+			id := int64(num(n["databaseId"]))
+			job, attempt := "job-b", int64(1)
+			if id == 1 { job = "job-a" }; if id == 3 { attempt = 2 }; if missing { job = "" }
+			return checkRunAttempt{"workflow", job, 1, attempt}, true, nil
+		})
+		want := 2; if missing { want = 3 }
+		if len(nodes(statusRollup(pr)["contexts"].(map[string]any)["nodes"])) != want || ciSummaryFromGraphQL(pr) != domain.CIFailing || ciSummaryFromRollupState(pr) != domain.CIFailing { t.Fatal("different or unproven logical job hid failure") }
+	}
+}
