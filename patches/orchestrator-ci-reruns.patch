+package github
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/domain"
+)
+
+type checkRunAttempt struct {
+	workflow        string
+	job             string
+	number, attempt int64
+}
+type checkWorkflowRun struct {
+	ID         int64  `json:"id"`
+	Head       string `json:"head_sha"`
+	Workflow   int64  `json:"workflow_id"`
+	Number     int64  `json:"run_number"`
+	Event      string `json:"event"`
+	Repository struct {
+		FullName string `json:"full_name"`
+	} `json:"repository"`
+}
+
+// normalizeCheckReruns requires matching workflow, event and job provenance.
+// Attempt-specific REST IDs do not prove cross-attempt logical job identity.
+func (p *Provider) normalizeCheckReruns(ctx context.Context, owner, repo, head string, pr map[string]any) error {
+	type runResult struct { run checkWorkflowRun; err error }
+	runs := map[int64]runResult{}
+	return supersedeCheckReruns(pr, func(n map[string]any) (checkRunAttempt, bool, error) {
+		u, err := url.Parse(str(n["detailsUrl"]))
+		if err != nil || u.Host != "github.com" {
+			return checkRunAttempt{}, false, nil
+		}
+		parts := strings.Split(strings.Trim(u.Path, "/"), "/")
+		if len(parts) != 7 || parts[0] != owner || parts[1] != repo || parts[2] != "actions" || parts[3] != "runs" || parts[5] != "job" {
+			return checkRunAttempt{}, false, nil
+		}
+		runID, e1 := strconv.ParseInt(parts[4], 10, 64)
+		jobID, e2 := strconv.ParseInt(parts[6], 10, 64)
+		checkID := int64(num(n["databaseId"]))
+		if e1 != nil || e2 != nil || runID <= 0 || jobID <= 0 || checkID <= 0 {
+			return checkRunAttempt{}, false, nil
+		}
+		read := func(path string, out any) error {
+			r, e := p.client.doREST(ctx, http.MethodGet, path, nil, nil)
+			if e != nil {
+				return e
+			}
+			return json.Unmarshal(r.Body, out)
+		}
+		var job struct {
+			ID       int64  `json:"id"`
+			RunID    int64  `json:"run_id"`
+			Head     string `json:"head_sha"`
+			Attempt  int64  `json:"run_attempt"`
+			CheckURL string `json:"check_run_url"`
+		}
+		if err := read(repoPath(owner, repo, "actions", "jobs", parts[6]), &job); err != nil {
+			return checkRunAttempt{}, false, nil
+		}
+		cached, ok := runs[runID]
+		if !ok {
+			cached.err = read(repoPath(owner, repo, "actions", "runs", parts[4]), &cached.run)
+			runs[runID] = cached
+		}
+		if cached.err != nil {
+			return checkRunAttempt{}, false, nil
+		}
+		run := cached.run
+		if job.ID != jobID || job.RunID != runID || job.Head != head || job.Attempt <= 0 || job.CheckURL != fmt.Sprintf("https://api.github.com/repos/%s/%s/check-runs/%d", owner, repo, checkID) || run.ID != runID || run.Head != head || run.Workflow <= 0 || run.Number <= 0 || run.Event == "" || run.Repository.FullName != owner+"/"+repo {
+			return checkRunAttempt{}, false, nil
+		}
+		// REST job IDs are attempt-specific. Without a stable logical-job ID,
+		// retain distinct IDs rather than infer identity from a display name.
+		return checkRunAttempt{workflow: fmt.Sprintf("%d:%s", run.Workflow, run.Event), job: strconv.FormatInt(job.ID, 10), number: run.Number, attempt: job.Attempt}, true, nil
+	})
+}
+
+func supersedeCheckReruns(pr map[string]any, resolve func(map[string]any) (checkRunAttempt, bool, error)) error {
+	roll := statusRollup(pr)
+	if roll == nil {
+		return nil
+	}
+	contexts, _ := roll["contexts"].(map[string]any)
+	// A partial connection cannot establish that all failures are represented.
+	if pageInfoHasMore(contexts) {
+		return nil
+	}
+	raw := nodes(contexts["nodes"])
+	groups := map[string][]int{}
+	for i, n := range raw {
+		if str(n["__typename"]) == "CheckRun" {
+			groups[str(n["name"])] = append(groups[str(n["name"])], i)
+		}
+	}
+	dropped := map[int]bool{}
+	for _, group := range groups {
+		if len(group) < 2 {
+			continue
+		}
+		attempts := map[int]checkRunAttempt{}
+		complete := true
+		for _, i := range group {
+			a, ok, err := resolve(raw[i])
+			if err != nil {
+				return err
+			}
+			if !ok {
+				complete = false
+				break
+			}
+			attempts[i] = a
+		}
+		if !complete {
+			continue
+		}
+		latest := map[string]checkRunAttempt{}
+		for _, a := range attempts {
+			if a.job == "" { continue }
+			key := a.workflow + ":job:" + a.job
+			old := latest[key]
+			if a.number > old.number || a.number == old.number && a.attempt > old.attempt {
+				latest[key] = a
+			}
+		}
+		for i, a := range attempts {
+			if a.job == "" { continue }
+			last := latest[a.workflow + ":job:" + a.job]
+			if a.number < last.number || a.number == last.number && a.attempt < last.attempt {
+				dropped[i] = true
+			}
+		}
+	}
+	if len(dropped) == 0 {
+		return nil
+	}
+	kept := []any{}
+	for i, n := range raw {
+		if !dropped[i] {
+			kept = append(kept, n)
+		}
+	}
+	contexts["nodes"] = kept
+	// The original aggregate also includes superseded failures. Recompute only
+	// after removing a proven older run, preserving all other visible failures.
+	state := ciSummaryFromGraphQL(pr)
+	switch state {
+	case domain.CIPassing:
+		roll["state"] = "SUCCESS"
+	case domain.CIFailing:
+		roll["state"] = "FAILURE"
+	case domain.CIPending:
+		roll["state"] = "PENDING"
+	default:
+		roll["state"] = "EXPECTED"
+	}
+	return nil
+}
